{
  "name": "student-contribution-tracker-backend",
  "version": "1.0.0",
  "description": "Backend for Student Contribution Tracking and Assignment Analytics Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "node init && tsc",
    "start": "node init && node dist/server.js",
    "dev": "node init && nodemon --watch src -e ts --exec ts-node src/server.ts",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2"
  }
}
