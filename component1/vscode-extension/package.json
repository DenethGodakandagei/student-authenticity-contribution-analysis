{
  "name": "student-contribution-tracker",
  "displayName": "INCODE - Student Contribution Tracker",
  "description": "Automatically tracks coding sessions, file edits, git commits, and keystrokes inside your assigned project repo and syncs contribution analytics to the INCODE platform.",
  "version": "3.0.5",
  "publisher": "academic-innovation",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/academic-innovation/collabintel"
  },
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onView:collabintel.sidebarView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "collabintel.setup",
        "title": "INCODE: Setup – Link Token & Assignment",
        "icon": "$(gear)"
      },
      {
        "command": "collabintel.openDashboard",
        "title": "INCODE: Open Interactive Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "collabintel.sync",
        "title": "INCODE: Sync Telemetry Now",
        "icon": "$(sync)"
      },
      {
        "command": "collabintel.testConnection",
        "title": "INCODE: Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "collabintel.status",
        "title": "INCODE: Show Status",
        "icon": "$(info)"
      },
      {
        "command": "collabintel.viewQueueStatus",
        "title": "Telemetry: View Local Queue Status",
        "icon": "$(database)"
      },
      {
        "command": "collabintel.switchMode",
        "title": "INCODE: Switch Operating Mode (Real vs Experimental)",
        "icon": "$(gear)"
      },
      {
        "command": "collabintel.setupParticipant",
        "title": "Experiment: Set Participant & Task Mode (P01-P20)",
        "icon": "$(account)"
      },
      {
        "command": "collabintel.switchTask",
        "title": "Experiment: Switch Current Task (Task A / Task B)",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "collabintel.statusBarMenu",
        "title": "INCODE: Open Status Bar Menu",
        "icon": "$(menu)"
      },
      {
        "command": "telemetry.exportBundle",
        "title": "Experiment: 1-Click Export Local Telemetry Database (.sqlite)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "collabintel.exportLocalData",
        "title": "INCODE: 1-Click Export Local Telemetry Database (.sqlite / JSON)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "extension.toggleProvenanceHighlighting",
        "title": "INCODE: Toggle Live Line Provenance Highlighting (Typed vs Pasted)",
        "icon": "$(paintcan)"
      },
      {
        "command": "collabintel.toggleProvenanceHighlighting",
        "title": "INCODE: Toggle Live Line Provenance Highlighting",
        "icon": "$(paintcan)"
      },
      {
        "command": "collabintel.markLineManual",
        "title": "INCODE: Mark Selected Line(s) as Manual [MANUAL]",
        "icon": "$(edit)"
      },
      {
        "command": "collabintel.markLineAi",
        "title": "INCODE: Mark Selected Line(s) as AI-Generated [AI]",
        "icon": "$(sparkle)"
      },
      {
        "command": "collabintel.markLinePasted",
        "title": "INCODE: Mark Selected Line(s) as Pasted [PASTED]",
        "icon": "$(clippy)"
      },
      {
        "command": "collabintel.markFileAi",
        "title": "INCODE: Mark Entire Current File as AI-Generated [AI]",
        "icon": "$(sparkle)"
      },
      {
        "command": "collabintel.markFilePasted",
        "title": "INCODE: Mark Entire Current File as Pasted [PASTED]",
        "icon": "$(clippy)"
      },
      {
        "command": "collabintel.chooseLineProvenance",
        "title": "INCODE: Change Provenance for Current Line...",
        "icon": "$(list-selection)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "collabintel.markLineManual",
          "group": "incode_provenance@1"
        },
        {
          "command": "collabintel.markLineAi",
          "group": "incode_provenance@2"
        },
        {
          "command": "collabintel.markLinePasted",
          "group": "incode_provenance@3"
        },
        {
          "command": "collabintel.markFileAi",
          "group": "incode_provenance@4"
        },
        {
          "command": "collabintel.markFilePasted",
          "group": "incode_provenance@5"
        },
        {
          "command": "collabintel.chooseLineProvenance",
          "group": "incode_provenance@6"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "collabintel-container",
          "title": "INCODE Tracker",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "collabintel-container": [
        {
          "type": "webview",
          "id": "collabintel.sidebarView",
          "name": "Live Telemetry & Activity"
        }
      ]
    },
    "configuration": {
      "title": "INCODE Student Tracker",
      "properties": {
        "collabintel.authToken": {
          "type": "string",
          "default": "",
          "description": "Your JWT auth token copied from the CollabIntel student dashboard."
        },
        "collabintel.assignmentId": {
          "type": "string",
          "default": "",
          "description": "The assignment ID you are tracking. Get this from your student dashboard."
        },
        "collabintel.serverUrl": {
          "type": "string",
          "default": "https://student-authenticity-contribution-80jm.onrender.com",
          "description": "CollabIntel backend server URL."
        },
        "collabintel.syncIntervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "How often (in minutes) the extension should automatically sync telemetry data."
        },
        "collabintel.trackOnlyLinkedRepo": {
          "type": "boolean",
          "default": true,
          "description": "If true, only track files inside the workspace folder matching the assignment's linked GitHub repository."
        },
        "collabintel.operatingMode": {
          "type": "string",
          "enum": [
            "real",
            "experimental"
          ],
          "enumDescriptions": [
            "Real Mode: Production academic coursework tracking for assignments and grading.",
            "Experimental Mode: Research participant pilot study with Task A/B ground truth tagging."
          ],
          "default": "real",
          "description": "Operating mode: 'real' for real student coursework tracking, or 'experimental' for research pilot study."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node copy-assets.js",
    "compile": "tsc -p ./ && node copy-assets.js",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.5"
  }
}
