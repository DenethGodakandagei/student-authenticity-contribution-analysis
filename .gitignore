# ==========================================
# Comprehensive .gitignore
# Student Authenticity & Contribution Analysis
# ==========================================

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Production Builds & Caches
# ------------------------------------------
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/

# ------------------------------------------
# Python (ML Scripts, Feature Extraction)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.joblib
trained_models/

# Nova RAG knowledge base artifacts (built chunks + vectors)
**/backend/knowledge/

# Auth user database (SQLite)
**/backend/data/

# ------------------------------------------
# Datasets, Database & Telemetry Exports
# ------------------------------------------
*.csv
*.tsv
*.parquet
*.sqlite
*.sqlite3
*.db
collabintel_telemetry.db
*.jsonl
# Un-comment if you want to keep specific sample datasets tracked:
# !telemetry_dataset.csv
# !pilot_dataset.csv

# ------------------------------------------
# VS Code Extension Development & Packaging
# ------------------------------------------
*.vsix
.vscode-test/
.vscode-test-web/

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# ------------------------------------------
# IDEs & Editors
# ------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
